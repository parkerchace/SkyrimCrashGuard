{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "skyrim-crash-guard",
  "version-semver": "2.4.0",
  "description": "Engine-level crash recovery system for Skyrim AE/VR using SKSE and CommonLibSSE NG.",
  "license": "GPL-3.0-or-later",
  "supports": "windows & x64",
  "dependencies": [
    "directxmath",
    "directxtk",
    "fmt",
    "nlohmann-json",
    "rapidcsv",
    "spdlog",
    "toml11",
    "zydis",
    {
      "name": "imgui",
      "features": ["dx11-binding", "win32-binding"]
    }
  ],
  "features": {
    "tests": {
      "description": "Dependencies for the Crash Guard unit tests.",
      "dependencies": [
        "catch2",
        "rapidcheck"
      ]
    }
  },
  "builtin-baseline": "6d7bf7ef2193e2d1c5798a5ff8811d533104c861"
}
