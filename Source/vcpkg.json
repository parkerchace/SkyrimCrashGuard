{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "skyrim-crash-guard",
  "version-semver": "2.1.0",
  "description": "Engine-level crash recovery system for Skyrim SE/AE using SKSE and CommonLibSSE.",
  "supports": "windows & x64",
  "dependencies": [
    "commonlibsse-ng",
    "spdlog",
    "fmt",
    "zydis",
    "nlohmann-json",
    "toml11",
    "catch2",
    "rapidcheck",
    "directxtk",
    {
      "name": "imgui",
      "features": ["dx11-binding", "win32-binding"]
    }
  ],
  "builtin-baseline": "d1e11918f5c88c1dd364b93e1452fea69bacd479",
  "overrides": [
    {
      "name": "commonlibsse-ng",
      "version": "3.6.0"
    }
  ]
}
